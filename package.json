{
  "name": "jellyfin-mcp",
  "version": "0.4.0",
  "description": "jellyctrl operator CLI for Jellyfin with a compatible MCP adapter for typed tool calls",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jellyfin-mcp": "dist/mcp-bin.js",
    "jellyfin-mcp-http": "dist/http-bin.js",
    "jellyctrl": "dist/cli.js",
    "jellyctl": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start:http": "node dist/http-bin.js",
    "start": "node dist/cli.js mcp",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "audit:prod": "node scripts/audit-prod.mjs",
    "prepublishOnly": "npm test && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "author": "Solomon Neas <me@solomonneas.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lidless-labs/jellyctrl.git"
  },
  "homepage": "https://github.com/lidless-labs/jellyctrl#readme",
  "bugs": {
    "url": "https://github.com/lidless-labs/jellyctrl/issues"
  },
  "keywords": [
    "mcp",
    "cli",
    "jellyctrl",
    "jellyfin",
    "media-server",
    "model-context-protocol",
    "llm-tools",
    "claude",
    "home-media"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@effect/platform": "^0.96.2",
    "@lidless-labs/effect-operator-kit": "github:lidless-labs/effect-operator-kit#1505318b2625fc273c51018389e2c61677e073d7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "effect": "^3.21.4",
    "undici": "^7.30.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@hono/node-server": "1.19.17"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
